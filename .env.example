# ---------------------------------------------------------------------------
# Public site config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# Email capture (choose ONE provider and wire it in components/EmailSignup.tsx)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVERTKIT_FORM_ID=
NEXT_PUBLIC_BEEHIIV_PUB_ID=
NEXT_PUBLIC_MAILERLITE_FORM_ID=
NEXT_PUBLIC_TALLY_FORM_ID=
# Server-side Resend (optional, for transactional / lead-magnet delivery)
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Forms (Formspree / Tally) — used by Contact + Consultation intake
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
NEXT_PUBLIC_FORMSPREE_CONSULT_ID=

# ---------------------------------------------------------------------------
# Analytics (all optional — leave blank to disable)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
